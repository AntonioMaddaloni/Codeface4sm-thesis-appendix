digraph pieGraph {
	graph [bgcolor=transparent, fontcolor=black, ratio=fill, overlap=prism, splines=TRUE, rank=same, size=7, rankdir=TB];
	node [label="\N", shape=ellipse, fixedsize=TRUE, fillcolor=transparent, color=black, fontcolor=black, fontsize=14, height="0.5", width="0.75", style=wedged];
	edge [headport=center, color=black, dir=none, weight="1.0", fontcolor=black, arrowhead=none, arrowtail=none, fontsize=14, labelfontsize=11, arrowsize=1, style=solid, minlen=1, penwidth="1.0"];
	graph [bb="0 0 503 503"];
	subgraph cluster_0 {
		graph [bgcolor="#4DFF4D80",
			bb="",
			penwidth=75,
			style=bold,
			color="#E495A5",
			label="ID 1",
			fontsize=120];
		1 [label=99820321, fillcolor="#E495A5;1:", height=5, width=5];
		2 [label=99820319, fillcolor="#E495A5;1:", height="1.62954997797011", width="1.62954997797011"];
		3 [label=99820320, fillcolor="#E495A5;1:", height="3.67605353274999", width="3.67605353274999"];
		4 [label=99820322, fillcolor="#E495A5;1:", height="0.749999999999999", width="0.749999999999999"];
		1 -> 2:center [color="#00000040", dir=both, weight=1, arrowhead=open, arrowtail=open, arrowsize="3.33333333333333", penwidth=10];
		1 -> 3:center [color="#00000040", dir=both, weight=1, arrowhead=open, arrowtail=open, arrowsize="3.33333333333333", penwidth=10];
		1 -> 4:center [color="#00000040", dir=forward, weight=1, arrowhead=open, arrowsize="3.33333333333333", penwidth=10];
		2 -> 3:center [color="#00000040", dir=forward, weight=1, arrowhead=open, arrowsize="3.33333333333333", penwidth=10];
	}
}
